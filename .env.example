# Required — used for syllabus extraction and the research agent loop
ANTHROPIC_API_KEY=sk-ant-…

# Optional — enables Steel-powered web research (https://app.steel.dev/settings/api-keys)
# Without it, research falls back to plain HTTP fetches.
STEEL_API_KEY=ste-…

# Supabase — cloud Postgres for tasks/sessions (run supabase_schema.sql once in the SQL editor)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_…

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-4-5
# FLASK_DEBUG=1
